{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f5f3ff", "$description": "Derived light mode; cool lavender-white surface." },
      "foreground": { "$value": "#171329" },
      "border": { "$value": "#d8d1ee" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#171329" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#171329" },
      "primary": {
        "$value": "#087e8b",
        "$description": "Derived light counterpart to Hush's neon-cyan primary."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#e9e4ff" },
      "secondaryForeground": { "$value": "#31254c" },
      "muted": { "$value": "#efedf7" },
      "mutedForeground": { "$value": "#5f5872" },
      "accent": { "$value": "#9c36b4" },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#b62951" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#c6bedc" },
      "ring": { "$value": "#087e8b" },
      "chart1": { "$value": "#087e8b" },
      "chart2": { "$value": "#aa28b9" },
      "chart3": { "$value": "#bf8100" },
      "chart4": { "$value": "#508224" },
      "chart5": { "$value": "#6339b6" },
      "sidebar": { "$value": "#f0edfb" },
      "sidebarForeground": { "$value": "#171329" },
      "sidebarBorder": { "$value": "#d8d1ee" },
      "sidebarPrimary": { "$value": "#087e8b" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#e7e1f7" },
      "sidebarAccentForeground": { "$value": "#31254c" },
      "sidebarRing": { "$value": "#087e8b" }
    },
    "dark": {
      "background": { "$value": "#080914", "$description": "Midnight navy from Hush's arcade-terminal theme." },
      "foreground": { "$value": "#f4efff" },
      "border": { "$value": "#423666" },
      "card": { "$value": "#101225" },
      "cardForeground": { "$value": "#f4efff" },
      "popover": { "$value": "#111427" },
      "popoverForeground": { "$value": "#f4efff" },
      "primary": { "$value": "#31eaff", "$description": "Neon cyan for primary actions, links, and focus." },
      "primaryForeground": { "$value": "#080914" },
      "secondary": { "$value": "#201b38" },
      "secondaryForeground": { "$value": "#eee9ff" },
      "muted": { "$value": "#19182e" },
      "mutedForeground": { "$value": "#aaa8c8" },
      "accent": { "$value": "#ec62ff", "$description": "Arcade magenta-violet highlight." },
      "accentForeground": { "$value": "#080914" },
      "destructive": { "$value": "#ff7188" },
      "destructiveForeground": { "$value": "#190915" },
      "input": { "$value": "#41375f" },
      "ring": { "$value": "#31eaff" },
      "chart1": { "$value": "#31eaff" },
      "chart2": { "$value": "#ec62ff" },
      "chart3": { "$value": "#ffdc4a" },
      "chart4": { "$value": "#b7ff55" },
      "chart5": { "$value": "#9d7bff" },
      "sidebar": { "$value": "#0b0d1b" },
      "sidebarForeground": { "$value": "#f4efff" },
      "sidebarBorder": { "$value": "#302b52" },
      "sidebarPrimary": { "$value": "#31eaff" },
      "sidebarPrimaryForeground": { "$value": "#080914" },
      "sidebarAccent": { "$value": "#19162d" },
      "sidebarAccentForeground": { "$value": "#f4efff" },
      "sidebarRing": { "$value": "#31eaff" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["ui-monospace", "SFMono-Regular", "Cascadia Code", "Liberation Mono", "monospace"],
        "$description": "System monospace stack used by Hush; no custom font files were supplied."
      },
      "serif": { "$value": ["ui-monospace", "SFMono-Regular", "Cascadia Code", "Liberation Mono", "monospace"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Cascadia Code", "Liberation Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.2rem",
      "$description": "Compact, squared treatment used by Hush's terminal panels and controls."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
